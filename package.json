{
  "name": "app-coldstart-desktop",
  "version": "2.0.0",
  "description": "App 冷启测速桌面版 — Electron 客户端",
  "main": "electron/main.js",
  "author": "田海顺",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "release": "node scripts/release.js",
    "gen-doc": "python scripts/gen-release-doc.py"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.app-coldstart.desktop",
    "productName": "AppColdStart",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      { "from": "server.py", "to": "backend/server.py" },
      { "from": "requirements.txt", "to": "backend/requirements.txt" },
      { "from": "adb/", "to": "backend/adb/" },
      { "from": "ios/", "to": "backend/ios/" },
      { "from": "static/", "to": "backend/static/" },
      { "from": "scrcpy/", "to": "scrcpy/" },
      { "from": "python-embed/", "to": "python-embed/", "filter": ["**/*"] },
      { "from": "CHANGELOG.md", "to": "CHANGELOG.md" }
    ],
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  }
}
