# Python 运行产物
__pycache__/
*.pyc

# 虚拟环境
.venv/

# Claude Code 本地配置
.claude/

# ZCode agent 本地配置 + plan 文件（agent 工具自动生成，与项目无关）
.zcode/

# 临时文件（防御性，正常不会在项目目录）
_cst_*.png
_cst_*.apk

# 用户冷启动项目配置（含模板图，本机私有，不入版本库）
projects/

# Stitch 生成的 UI 设计稿（仅作设计参考，非项目运行所需，不入版本控制）
stitch_adaptive_responsive_shortcut_layout/
chk.html

# 本地 npm 依赖（Electron / electron-builder）
node_modules/

# Electron 打包产物（electron-builder 输出）
release/

# 发布产物（安装包 + Word 发布说明，由 scripts/release.mjs 生成）
publish/

# 嵌入式 Python 运行时（~300MB，由 scripts/build-python-embed.py 构建）
python-embed/

# server.pyc 编译产物（由 after-pack 钩子在打包时生成）
server.pyc

# Electron 运行时缓存
dist-electron/

# pytest 缓存
.pytest_cache/

# scrcpy 二进制（32MB，从官方 release 下载放入，不入版本库）
scrcpy/

# iOS 工具链（libimobiledevice，19MB，从 XYLog / libimobiledevice-win32 复制，不入版本库）
ios/
